<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon for Android 7 (API 24-25): the same drawing on a circle,
     drawn from vectors at every density. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/brand_amber" />
            <size android:width="48dp" android:height="48dp" />
        </shape>
    </item>
    <item
        android:bottom="-6dp"
        android:drawable="@drawable/ic_launcher_foreground"
        android:left="-6dp"
        android:right="-6dp"
        android:top="-6dp" />
</layer-list>
