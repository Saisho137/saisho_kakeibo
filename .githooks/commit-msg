#!/bin/sh
# Enforces Conventional Commits: type(scope)!: description
# Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .{1,100}$'
first_line=$(head -n 1 "$1")

case "$first_line" in
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac

if ! echo "$first_line" | grep -Eq "$pattern"; then
  echo "✖ Commit message does not follow Conventional Commits:"
  echo "    $first_line"
  echo "  Expected: <type>(<scope>)?: <description>   e.g. feat(tasks): add delete action"
  exit 1
fi
