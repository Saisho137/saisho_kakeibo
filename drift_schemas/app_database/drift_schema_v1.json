      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"currencies\" (\"code\" TEXT NOT NULL, \"symbol\" TEXT NOT NULL, \"decimals\" INTEGER NOT NULL, \"thousands_separator\" TEXT NOT NULL, \"decimal_separator\" TEXT NOT NULL, \"is_built_in\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_built_in\" IN (0, 1)), PRIMARY KEY (\"code\"));"
        }
