        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"id\" INTEGER NOT NULL CHECK(\"id\" = 1), \"main_currency_code\" TEXT NOT NULL REFERENCES currencies (code), \"period_type\" TEXT NOT NULL, \"cutoff_day\" INTEGER NOT NULL, \"min_days_between_periods\" INTEGER NOT NULL, \"notifications_enabled\" INTEGER NOT NULL CHECK (\"notifications_enabled\" IN (0, 1)), \"reminder_minutes\" INTEGER NOT NULL, \"theme_mode\" TEXT NOT NULL, \"balance_filter\" TEXT NOT NULL, \"backups_to_keep\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
